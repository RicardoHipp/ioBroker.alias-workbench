{
  "note": "Device knowledge, not code. The keys are Tasmota command names as they appear in tele/STATE and StatusSTS. %N% stands for the output number, so one entry covers POWER1 to POWER8. The descriptions shown in the dialog live in admin/i18n (key cmd.<name>, %N% written as N).",
  "notCommands": [
    "Time",
    "Uptime",
    "UptimeSec",
    "Heap",
    "LoadAvg",
    "MqttCount",
    "Hostname",
    "IPAddress",
    "StatusSTS",
    "Wifi",
    "Berry",
    "Vcc",
    "Command"
  ],
  "commands": {
    "POWER": {
      "role": "switch",
      "type": "boolean",
      "writeFormula": "val ? \"ON\" : \"OFF\""
    },
    "POWER%N%": {
      "role": "switch",
      "type": "boolean",
      "writeFormula": "val ? \"ON\" : \"OFF\""
    },
    "Dimmer": {
      "role": "level.dimmer",
      "type": "number",
      "unit": "%"
    },
    "Color": {
      "role": "level.color.rgb",
      "type": "string"
    },
    "HSBColor": {
      "role": "level.color.hue",
      "type": "string",
      "duplicateOf": "Color"
    },
    "Channel": {
      "role": "level.dimmer",
      "type": "string",
      "duplicateOf": "Color"
    },
    "CT": {
      "role": "level.color.temperature",
      "type": "number",
      "unit": "mired"
    },
    "White": {
      "role": "level.dimmer",
      "type": "number",
      "unit": "%"
    },
    "Scheme": {
      "role": "level.effect",
      "type": "number",
      "states": {
        "0": "single colour",
        "1": "wake up",
        "2": "cycle colours up",
        "3": "cycle colours down",
        "4": "random"
      }
    },
    "Speed": {
      "role": "level",
      "type": "number",
      "offByDefault": true
    },
    "Fade": {
      "role": "switch",
      "type": "boolean",
      "writeFormula": "val ? \"ON\" : \"OFF\""
    },
    "LedTable": {
      "role": "switch",
      "type": "boolean",
      "writeFormula": "val ? \"ON\" : \"OFF\"",
      "offByDefault": true
    },
    "Sleep": {
      "role": "level",
      "type": "number",
      "unit": "ms",
      "offByDefault": true
    },
    "TelePeriod": {
      "role": "level",
      "type": "number",
      "unit": "s",
      "offByDefault": true
    },
    "SleepMode": {
      "role": "text",
      "type": "string",
      "offByDefault": true
    }
  }
}
