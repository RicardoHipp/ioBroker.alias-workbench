{
  "id": "tasmota-lampe",
  "version": 6,
  "rang": 10,
  "name": {
    "de": "Tasmota-Lampe",
    "en": "Tasmota light"
  },
  "geraetetyp": "light",
  "funktion": "light",
  "erkennung": {
    "erforderlich": [
      "cmnd.POWER"
    ],
    "inhalt": {
      "tele.STATE": "POWER"
    },
    "namenshinweis": "licht|lampe|light|led|leuchte|strahler",
    "hinweis": "stat.POWER steht bewusst nicht in der Pflichtliste: den Punkt legt der mqtt-Adapter erst an, wenn das Geraet zum ersten Mal geschaltet hat. Vorher haette die Vorlage nie gegriffen, obwohl der Schaltzustand die ganze Zeit in tele.STATE steht - von dort liest sie ersatzweise. cmnd.POWER bleibt dagegen Pflicht: es ist der Beleg dafuer, dass hier ueberhaupt etwas zu schalten ist. Ohne ihn wuerde jeder blosse Messpunkt mit Relaismeldung als Steckdose durchgehen."
  },
  "zustaende": [
    {
      "name": "SET",
      "rolle": "switch.light",
      "typ": "boolean",
      "lesen": "stat.POWER",
      "schreiben": "cmnd.POWER",
      "schreibformel": "val ? \"ON\" : \"OFF\"",
      "lesenSonst": {
        "punkt": "tele.STATE",
        "leseformel": "JSON.parse(val)?.POWER === 'ON'"
      }
    },
    {
      "name": "ON_ACTUAL",
      "rolle": "sensor.light",
      "typ": "boolean",
      "lesen": "stat.POWER",
      "hinweis": "beim light heisst die Rueckmeldung ON_ACTUAL, nicht ACTUAL",
      "lesenSonst": {
        "punkt": "tele.STATE",
        "leseformel": "JSON.parse(val)?.POWER === 'ON'"
      }
    },
    {
      "name": "ELECTRIC_POWER",
      "rolle": "value.power",
      "typ": "number",
      "einheit": "W",
      "lesen": "tele.SENSOR",
      "feld": "ENERGY.Power",
      "optional": true
    },
    {
      "name": "CONSUMPTION",
      "rolle": "value.power.consumption",
      "typ": "number",
      "einheit": "kWh",
      "lesen": "tele.SENSOR",
      "feld": "ENERGY.Total",
      "optional": true
    },
    {
      "name": "VOLTAGE",
      "rolle": "value.voltage",
      "typ": "number",
      "einheit": "V",
      "lesen": "tele.SENSOR",
      "feld": "ENERGY.Voltage",
      "optional": true
    },
    {
      "name": "CURRENT",
      "rolle": "value.current",
      "typ": "number",
      "einheit": "A",
      "lesen": "tele.SENSOR",
      "feld": "ENERGY.Current",
      "optional": true
    },
    {
      "name": "TODAY",
      "rolle": "value",
      "typ": "number",
      "einheit": "kWh",
      "lesen": "tele.SENSOR",
      "feld": "ENERGY.Today",
      "optional": true,
      "vorgabeAus": true
    },
    {
      "name": "YESTERDAY",
      "rolle": "value",
      "typ": "number",
      "einheit": "kWh",
      "lesen": "tele.SENSOR",
      "feld": "ENERGY.Yesterday",
      "optional": true,
      "vorgabeAus": true
    },
    {
      "name": "APPARENT_POWER",
      "rolle": "value",
      "typ": "number",
      "einheit": "VA",
      "lesen": "tele.SENSOR",
      "feld": "ENERGY.ApparentPower",
      "optional": true,
      "vorgabeAus": true,
      "hinweis": "Scheinleistung. Kein Platz in socket oder light — landet wie TODAY im info-Geraet."
    },
    {
      "name": "REACTIVE_POWER",
      "rolle": "value",
      "typ": "number",
      "einheit": "var",
      "lesen": "tele.SENSOR",
      "feld": "ENERGY.ReactivePower",
      "optional": true,
      "vorgabeAus": true,
      "hinweis": "Blindleistung."
    },
    {
      "name": "POWER_FACTOR",
      "rolle": "value",
      "typ": "number",
      "lesen": "tele.SENSOR",
      "feld": "ENERGY.Factor",
      "optional": true,
      "vorgabeAus": true,
      "hinweis": "Leistungsfaktor cos phi, 0 bis 1 — ohne Einheit."
    },
    {
      "name": "UNREACH",
      "rolle": "indicator.maintenance.unreach",
      "typ": "boolean",
      "lesen": "tele.LWT",
      "leseformel": "val !== \"Online\"",
      "optional": true
    },
    {
      "name": "RSSI",
      "rolle": "value.rssi",
      "typ": "number",
      "einheit": "dBm",
      "lesen": "tele.STATE",
      "feld": "Wifi.Signal",
      "optional": true,
      "vorgabeAus": true
    },
    {
      "name": "UPTIME",
      "rolle": "value",
      "typ": "number",
      "einheit": "s",
      "lesen": "tele.STATE",
      "feld": "UptimeSec",
      "optional": true,
      "vorgabeAus": true,
      "hinweis": "Sekunden seit dem letzten Start. Faellt der Wert staendig zurueck, startet das Geraet neu."
    },
    {
      "name": "LAST_REPORT",
      "rolle": "text",
      "typ": "string",
      "lesen": "tele.STATE",
      "feld": "Time",
      "optional": true,
      "vorgabeAus": true,
      "hinweis": "Zeitstempel der letzten Telemetrie des Geraets, nicht der von ioBroker."
    },
    {
      "name": "HEAP",
      "rolle": "value",
      "typ": "number",
      "einheit": "kB",
      "lesen": "tele.STATE",
      "feld": "Heap",
      "optional": true,
      "vorgabeAus": true,
      "hinweis": "Freier Speicher. Wird er klein, wird das Geraet unzuverlaessig."
    },
    {
      "name": "WIFI_QUALITY",
      "rolle": "value",
      "typ": "number",
      "einheit": "%",
      "lesen": "tele.STATE",
      "feld": "Wifi.RSSI",
      "optional": true,
      "vorgabeAus": true,
      "hinweis": "Guete 0 bis 100. RSSI in dBm steht getrennt daneben."
    },
    {
      "name": "WIFI_SSID",
      "rolle": "text",
      "typ": "string",
      "lesen": "tele.STATE",
      "feld": "Wifi.SSId",
      "optional": true,
      "vorgabeAus": true
    },
    {
      "name": "WIFI_LINKCOUNT",
      "rolle": "value",
      "typ": "number",
      "lesen": "tele.STATE",
      "feld": "Wifi.LinkCount",
      "optional": true,
      "vorgabeAus": true,
      "hinweis": "Wie oft die WLAN-Verbindung seit dem Start neu aufgebaut wurde."
    },
    {
      "name": "WIFI_DOWNTIME",
      "rolle": "text",
      "typ": "string",
      "lesen": "tele.STATE",
      "feld": "Wifi.Downtime",
      "optional": true,
      "vorgabeAus": true,
      "hinweis": "Summe der Ausfallzeit seit dem Start."
    },
    {
      "name": "IP",
      "rolle": "text",
      "typ": "string",
      "lesen": "tele.STATE",
      "feld": "IPAddress",
      "optional": true,
      "vorgabeAus": true,
      "hinweis": "Drei Wege, weil keiner allein reicht. tele.STATE steht zuerst, weil es alle paar Minuten frisch kommt und einem Adresswechsel folgt - allerdings fuehrt es die IP erst ab neuerer Firmware mit (gemessen: 12.5.0 nein, 15.5.0 ja). tele.INFO2 schickt eine Tasmota beim Start und laesst es retained stehen; das steht auch bei alter Firmware da, ist aber ein Standbild vom letzten Boot. stat.STATUS5 entsteht, wenn jemand den Status abfragt.",
      "lesenSonst": [
        {
          "punkt": "tele.INFO2",
          "feld": "Info2.IPAddress"
        },
        {
          "punkt": "stat.STATUS5",
          "feld": "StatusNET.IPAddress"
        }
      ]
    }
  ],
  "nebenwirkungen": [
    {
      "art": "mqtt-publish",
      "punkt": "cmnd.POWER"
    }
  ],
  "weiterePunkte": {
    "tele.LWT": "text",
    "tele.STATE": "json",
    "tele.SENSOR": "json",
    "tele.INFO1": "json",
    "tele.INFO2": "json",
    "tele.INFO3": "json",
    "tele.HASS_STATE": "json",
    "stat.RESULT": "json",
    "stat.STATUS": "json",
    "stat.STATUS2": "json",
    "stat.STATUS5": "json",
    "stat.STATUS11": "json"
  }
}
