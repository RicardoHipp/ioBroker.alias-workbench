{
  "id": "messpunkt",
  "version": 4,
  "rang": 5,
  "name": {
    "de": "Reiner Messpunkt",
    "en": "Measurement point only"
  },
  "geraetetyp": "info",
  "hinweis": {
    "de": "Kein SET, also bewusst kein schaltbares Gerät. Für Tasmota-Geräte, die nur messen oder deren stat/cmnd noch nie gesendet haben.",
    "en": "No SET, so deliberately not a switchable device. For Tasmota devices that only measure or whose stat/cmnd topics have never been sent."
  },
  "erkennung": {
    "erforderlich": [
      "tele.SENSOR"
    ],
    "inhalt": {
      "tele.SENSOR": "ENERGY"
    }
  },
  "zustaende": [
    {
      "name": "ELECTRIC_POWER",
      "rolle": "value.power",
      "typ": "number",
      "einheit": "W",
      "lesen": "tele.SENSOR",
      "feld": "ENERGY.Power",
      "optional": true
    },
    {
      "name": "CONSUMPTION",
      "rolle": "value.power.consumption",
      "typ": "number",
      "einheit": "kWh",
      "lesen": "tele.SENSOR",
      "feld": "ENERGY.Total",
      "optional": true
    },
    {
      "name": "VOLTAGE",
      "rolle": "value.voltage",
      "typ": "number",
      "einheit": "V",
      "lesen": "tele.SENSOR",
      "feld": "ENERGY.Voltage",
      "optional": true
    },
    {
      "name": "CURRENT",
      "rolle": "value.current",
      "typ": "number",
      "einheit": "A",
      "lesen": "tele.SENSOR",
      "feld": "ENERGY.Current",
      "optional": true
    },
    {
      "name": "TODAY",
      "rolle": "value",
      "typ": "number",
      "einheit": "kWh",
      "lesen": "tele.SENSOR",
      "feld": "ENERGY.Today",
      "optional": true,
      "vorgabeAus": true
    },
    {
      "name": "APPARENT_POWER",
      "rolle": "value",
      "typ": "number",
      "einheit": "VA",
      "lesen": "tele.SENSOR",
      "feld": "ENERGY.ApparentPower",
      "optional": true,
      "vorgabeAus": true,
      "hinweis": "Scheinleistung. Kein Platz in socket oder light — landet wie TODAY im info-Geraet."
    },
    {
      "name": "REACTIVE_POWER",
      "rolle": "value",
      "typ": "number",
      "einheit": "var",
      "lesen": "tele.SENSOR",
      "feld": "ENERGY.ReactivePower",
      "optional": true,
      "vorgabeAus": true,
      "hinweis": "Blindleistung."
    },
    {
      "name": "POWER_FACTOR",
      "rolle": "value",
      "typ": "number",
      "lesen": "tele.SENSOR",
      "feld": "ENERGY.Factor",
      "optional": true,
      "vorgabeAus": true,
      "hinweis": "Leistungsfaktor cos phi, 0 bis 1 — ohne Einheit."
    },
    {
      "name": "UNREACH",
      "rolle": "indicator.maintenance.unreach",
      "typ": "boolean",
      "lesen": "tele.LWT",
      "leseformel": "val !== \"Online\"",
      "optional": true
    },
    {
      "name": "RSSI",
      "rolle": "value.rssi",
      "typ": "number",
      "einheit": "dBm",
      "lesen": "tele.STATE",
      "feld": "Wifi.Signal",
      "optional": true
    },
    {
      "name": "UPTIME",
      "rolle": "value",
      "typ": "number",
      "einheit": "s",
      "lesen": "tele.STATE",
      "feld": "UptimeSec",
      "optional": true,
      "vorgabeAus": true,
      "hinweis": "Sekunden seit dem letzten Start. Faellt der Wert staendig zurueck, startet das Geraet neu."
    },
    {
      "name": "LAST_REPORT",
      "rolle": "text",
      "typ": "string",
      "lesen": "tele.STATE",
      "feld": "Time",
      "optional": true,
      "vorgabeAus": true,
      "hinweis": "Zeitstempel der letzten Telemetrie des Geraets, nicht der von ioBroker."
    },
    {
      "name": "HEAP",
      "rolle": "value",
      "typ": "number",
      "einheit": "kB",
      "lesen": "tele.STATE",
      "feld": "Heap",
      "optional": true,
      "vorgabeAus": true,
      "hinweis": "Freier Speicher. Wird er klein, wird das Geraet unzuverlaessig."
    },
    {
      "name": "WIFI_QUALITY",
      "rolle": "value",
      "typ": "number",
      "einheit": "%",
      "lesen": "tele.STATE",
      "feld": "Wifi.RSSI",
      "optional": true,
      "vorgabeAus": true,
      "hinweis": "Guete 0 bis 100. RSSI in dBm steht getrennt daneben."
    },
    {
      "name": "WIFI_SSID",
      "rolle": "text",
      "typ": "string",
      "lesen": "tele.STATE",
      "feld": "Wifi.SSId",
      "optional": true,
      "vorgabeAus": true
    },
    {
      "name": "WIFI_LINKCOUNT",
      "rolle": "value",
      "typ": "number",
      "lesen": "tele.STATE",
      "feld": "Wifi.LinkCount",
      "optional": true,
      "vorgabeAus": true,
      "hinweis": "Wie oft die WLAN-Verbindung seit dem Start neu aufgebaut wurde."
    },
    {
      "name": "WIFI_DOWNTIME",
      "rolle": "text",
      "typ": "string",
      "lesen": "tele.STATE",
      "feld": "Wifi.Downtime",
      "optional": true,
      "vorgabeAus": true,
      "hinweis": "Summe der Ausfallzeit seit dem Start."
    },
    {
      "name": "IP",
      "rolle": "text",
      "typ": "string",
      "lesen": "tele.STATE",
      "feld": "IPAddress",
      "optional": true,
      "vorgabeAus": true,
      "hinweis": "Drei Wege, weil keiner allein reicht. tele.STATE steht zuerst, weil es alle paar Minuten frisch kommt und einem Adresswechsel folgt - allerdings fuehrt es die IP erst ab neuerer Firmware mit (gemessen: 12.5.0 nein, 15.5.0 ja). tele.INFO2 schickt eine Tasmota beim Start und laesst es retained stehen; das steht auch bei alter Firmware da, ist aber ein Standbild vom letzten Boot. stat.STATUS5 entsteht, wenn jemand den Status abfragt.",
      "lesenSonst": [
        {
          "punkt": "tele.INFO2",
          "feld": "Info2.IPAddress"
        },
        {
          "punkt": "stat.STATUS5",
          "feld": "StatusNET.IPAddress"
        }
      ]
    }
  ],
  "weiterePunkte": {
    "tele.LWT": "text",
    "tele.STATE": "json",
    "tele.SENSOR": "json",
    "tele.INFO1": "json",
    "tele.INFO2": "json",
    "tele.INFO3": "json",
    "tele.HASS_STATE": "json",
    "stat.RESULT": "json",
    "stat.STATUS": "json",
    "stat.STATUS2": "json",
    "stat.STATUS5": "json",
    "stat.STATUS11": "json"
  }
}
