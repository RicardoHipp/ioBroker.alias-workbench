{
  "id": "messpunkt",
  "version": 2,
  "rang": 5,
  "name": {
    "de": "Reiner Messpunkt",
    "en": "Measurement point only"
  },
  "geraetetyp": "info",
  "hinweis": {
    "de": "Kein SET, also bewusst kein schaltbares Gerät. Für Tasmota-Geräte, die nur messen oder deren stat/cmnd noch nie gesendet haben.",
    "en": "No SET, so deliberately not a switchable device. For Tasmota devices that only measure or whose stat/cmnd topics have never been sent."
  },
  "erkennung": {
    "erforderlich": [
      "tele.SENSOR"
    ],
    "inhalt": {
      "tele.SENSOR": "ENERGY"
    }
  },
  "zustaende": [
    {
      "name": "ELECTRIC_POWER",
      "rolle": "value.power",
      "typ": "number",
      "einheit": "W",
      "lesen": "tele.SENSOR",
      "feld": "ENERGY.Power",
      "optional": true
    },
    {
      "name": "CONSUMPTION",
      "rolle": "value.power.consumption",
      "typ": "number",
      "einheit": "kWh",
      "lesen": "tele.SENSOR",
      "feld": "ENERGY.Total",
      "optional": true
    },
    {
      "name": "VOLTAGE",
      "rolle": "value.voltage",
      "typ": "number",
      "einheit": "V",
      "lesen": "tele.SENSOR",
      "feld": "ENERGY.Voltage",
      "optional": true
    },
    {
      "name": "CURRENT",
      "rolle": "value.current",
      "typ": "number",
      "einheit": "A",
      "lesen": "tele.SENSOR",
      "feld": "ENERGY.Current",
      "optional": true
    },
    {
      "name": "TODAY",
      "rolle": "value",
      "typ": "number",
      "einheit": "kWh",
      "lesen": "tele.SENSOR",
      "feld": "ENERGY.Today",
      "optional": true,
      "vorgabeAus": true
    },
    {
      "name": "APPARENT_POWER",
      "rolle": "value",
      "typ": "number",
      "einheit": "VA",
      "lesen": "tele.SENSOR",
      "feld": "ENERGY.ApparentPower",
      "optional": true,
      "vorgabeAus": true,
      "hinweis": "Scheinleistung. Kein Platz in socket oder light — landet wie TODAY im info-Geraet."
    },
    {
      "name": "REACTIVE_POWER",
      "rolle": "value",
      "typ": "number",
      "einheit": "var",
      "lesen": "tele.SENSOR",
      "feld": "ENERGY.ReactivePower",
      "optional": true,
      "vorgabeAus": true,
      "hinweis": "Blindleistung."
    },
    {
      "name": "POWER_FACTOR",
      "rolle": "value",
      "typ": "number",
      "lesen": "tele.SENSOR",
      "feld": "ENERGY.Factor",
      "optional": true,
      "vorgabeAus": true,
      "hinweis": "Leistungsfaktor cos phi, 0 bis 1 — ohne Einheit."
    },
    {
      "name": "UNREACH",
      "rolle": "indicator.maintenance.unreach",
      "typ": "boolean",
      "lesen": "tele.LWT",
      "leseformel": "val !== \"Online\"",
      "optional": true
    },
    {
      "name": "RSSI",
      "rolle": "value.rssi",
      "typ": "number",
      "einheit": "dBm",
      "lesen": "tele.STATE",
      "feld": "Wifi.Signal",
      "optional": true
    }
  ]
}
