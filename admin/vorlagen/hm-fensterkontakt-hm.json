{
  "id": "hm-fensterkontakt-hm",
  "version": 2,
  "rang": 40,
  "name": {
    "de": "Homematic Fensterkontakt (ältere Reihe)",
    "en": "Homematic window contact (classic)"
  },
  "geraetetyp": "window",
  "funktion": "window",
  "hinweis": {
    "de": "HM-Sec-SCo und Verwandte aus der Reihe vor HmIP. Anders als der HmIP-Kontakt meldet dieser schon einen Wahrheitswert — es braucht keine Umrechnung.",
    "en": "HM-Sec-SCo and relatives from the generation before HmIP. Unlike the HmIP contact this one already reports a boolean, so no conversion is needed."
  },
  "erkennung": {
    "erforderlich": [
      "1.STATE",
      "1.ERROR"
    ],
    "verboten": [
      "1.WORKING"
    ],
    "hinweis": "1.ERROR gibt es beim HmIP-Kontakt nicht - daran trennen sich die beiden Fassungen. 1.WORKING bleibt verboten, damit kein Schaltaktor hier hereinrutscht."
  },
  "zustaende": [
    {
      "name": "ACTUAL",
      "rolle": "sensor.window",
      "typ": "boolean",
      "lesen": "1.STATE"
    },
    {
      "name": "ERROR",
      "rolle": "indicator.error",
      "typ": "number",
      "lesen": "1.ERROR",
      "optional": true,
      "vorgabeAus": true,
      "hinweis": "0 heisst in Ordnung, 7 Sabotage. Das window-Muster hat keinen Platz dafuer - angehakt landet der Punkt im info-Geraet."
    },
    {
      "name": "LOWBAT",
      "rolle": "indicator.lowbat",
      "typ": "boolean",
      "lesen": "0.LOWBAT",
      "lesenSonst": {
        "punkt": "1.LOWBAT"
      },
      "optional": true,
      "hinweis": "Dieses Geraet fuehrt LOWBAT zweimal, an Kanal 0 und an Kanal 1. Kanal 0 ist der Wartungskanal und die richtige Adresse."
    },
    {
      "name": "UNREACH",
      "rolle": "indicator.maintenance.unreach",
      "typ": "boolean",
      "lesen": "0.UNREACH",
      "optional": true
    },
    {
      "name": "STICKY_UNREACH",
      "rolle": "indicator.maintenance.unreach",
      "typ": "boolean",
      "lesen": "0.STICKY_UNREACH",
      "optional": true,
      "vorgabeAus": true,
      "hinweis": "Bleibt stehen, bis jemand sie zuruecksetzt - zeigt also auch einen Ausfall an, der schon wieder vorbei ist."
    },
    {
      "name": "RSSI",
      "rolle": "value.rssi",
      "typ": "number",
      "einheit": "dBm",
      "lesen": "0.RSSI_DEVICE",
      "lesenSonst": {
        "punkt": "0.RSSI_PEER"
      },
      "optional": true,
      "vorgabeAus": true,
      "hinweis": "RSSI_DEVICE steht zuerst: es ist der Pegel, den die Zentrale vom Geraet empfaengt. RSSI_PEER ist bei Batteriegeraeten oft unbelegt und traegt dann Grenzwerte wie -2147483648."
    }
  ],
