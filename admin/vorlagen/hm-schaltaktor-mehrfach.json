{
  "id": "hm-schaltaktor-mehrfach",
  "version": 4,
  "rang": 30,
  "name": {
    "de": "Homematic Schaltaktor mit mehreren Ausgängen",
    "en": "Homematic switch actuator, multiple outputs"
  },
  "geraetetyp": "light",
  "funktion": "socket",
  "hinweis": {
    "de": "Zweifach-Unterputzaktor wie HM-LC-Sw2PBU-FM. Je Ausgang entsteht ein eigenes Gerät, weil ein light genau ein SET hat — dieselbe Regel wie bei der Tasmota-Steckdosenleiste. %N% ist die Kanalnummer und wird aus den vorhandenen Objekten gelesen. Der Zielname trägt zunächst nur die Nummer; wenn die Kanäle im Objektbrowser eigene Namen haben (Bar, Esstisch), gehören die in die Zielzeile.",
    "en": "Two-gang flush-mounted actuator such as HM-LC-Sw2PBU-FM. One device per output, because a light has exactly one SET. %N% is the channel number, read from the objects that exist."
  },
  "mehrfach": {
    "platzhalter": "%N%"
  },
  "kanalname": "%N%",
  "erkennung": {
    "erforderlich": [
      "%N%.STATE",
      "%N%.WORKING",
      "2.STATE"
    ],
    "verboten": [
      "1.SET_POINT_TEMPERATURE"
    ],
    "hinweis": "2.STATE steht fest in der Liste, damit die Vorlage nicht auch am Einfach-Aktor greift - der hat nur Kanal 1 und gehoert zur Einfach-Vorlage. %N%.WORKING trennt die Schaltkanaele von allem anderen, was zufaellig STATE heisst: die Heizgruppe HmIP-HEATING hat einen schaltbaren 6.STATE, aber kein 6.WORKING, und der Fensterkontakt hat weder das eine noch das andere. Das verbotene SET_POINT_TEMPERATURE haelt zusaetzlich alle Thermostate fern."
  },
  "zustaende": [
    {
      "name": "SET",
      "rolle": "switch.light",
      "typ": "boolean",
      "lesen": "%N%.STATE",
      "schreiben": "%N%.STATE"
    },
    {
      "name": "ON_ACTUAL",
      "rolle": "sensor.light",
      "typ": "boolean",
      "lesen": "%N%.STATE",
      "optional": true,
      "hinweis": "Liest dieselbe Quelle wie SET - der Aktor meldet keinen getrennten Istwert, 1.STATE ist beides. Deshalb standardmaessig aus: angehakt stuende derselbe Wert zweimal im Alias, und die Pruefung „kein Punkt doppelt\" meldet es zu Recht. Anhaken nur, wenn ein Widget ausdruecklich einen eigenen Rueckmeldepunkt erwartet.",
      "vorgabeAus": true
    },
    {
      "name": "WORKING",
      "rolle": "indicator.working",
      "typ": "boolean",
      "lesen": "%N%.WORKING",
      "optional": true,
      "hinweis": "Gehoert zum einzelnen Ausgang, nicht zum Geraet - jeder Ausgang bekommt sein eigenes."
    },
    {
      "name": "ON_TIME",
      "rolle": "level.timer.off",
      "typ": "number",
      "einheit": "s",
      "lesen": "%N%.ON_TIME",
      "schreiben": "%N%.ON_TIME",
      "optional": true,
      "vorgabeAus": true,
      "hinweis": "Einschaltdauer in Sekunden. Der Platz ON_TIME im Muster nimmt ihn auf."
    },
    {
      "name": "INHIBIT",
      "rolle": "switch",
      "typ": "boolean",
      "lesen": "%N%.INHIBIT",
      "schreiben": "%N%.INHIBIT",
      "optional": true,
      "vorgabeAus": true,
      "hinweis": "Sperrt diesen Ausgang. Solange true, nimmt er keine Befehle an - auch nicht vom Taster."
    },
    {
      "name": "LOWBAT",
      "rolle": "indicator.lowbat",
      "typ": "boolean",
      "lesen": "0.LOWBAT",
      "lesenSonst": {
        "punkt": "0.LOW_BAT"
      },
      "optional": true,
      "hinweis": "Kanal 0 gilt fuer das ganze Geraet. Beide Ausgaenge bekommen denselben Punkt - die Meldung betrifft ja beide."
    },
    {
      "name": "UNREACH",
      "rolle": "indicator.maintenance.unreach",
      "typ": "boolean",
      "lesen": "0.UNREACH",
      "optional": true,
      "hinweis": "Kanal 0, gilt fuer beide Ausgaenge."
    },
    {
      "name": "RSSI",
      "rolle": "value.rssi",
      "typ": "number",
      "einheit": "dBm",
      "lesen": "0.RSSI_DEVICE",
      "optional": true,
      "vorgabeAus": true,
      "lesenSonst": {
        "punkt": "0.RSSI_PEER"
      },
      "hinweis": "RSSI_DEVICE steht zuerst: es ist der Pegel, den die Zentrale vom Geraet empfaengt. RSSI_PEER ist bei Batteriegeraeten oft unbelegt und traegt dann Grenzwerte wie -2147483648."
    }
  ],
