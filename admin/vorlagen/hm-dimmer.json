{
  "id": "hm-dimmer",
  "version": 2,
  "priority": 40,
  "name": {
    "de": "Homematic Dimmer",
    "en": "Homematic dimmer"
  },
  "deviceType": "dimmer",
  "enumFunction": "light",
  "note": {
    "de": "HM-LC-Dim1TPBU-FM und Verwandte. Das Gerät zeigt drei gleich aussehende Kanäle: 1 ist der echte Ausgang, 2 und 3 sind virtuelle Kanäle für Verknüpfungen und Effekte. Die Vorlage nimmt fest Kanal 1 — deshalb steht hier kein %N%.",
    "en": "HM-LC-Dim1TPBU-FM and relatives. Channel 1 is the real output; 2 and 3 are virtual channels for links and effects, so this template pins channel 1."
  },
  "detection": {
    "required": [
      "1.LEVEL",
      "1.LEVEL_REAL"
    ],
    "note": {
      "de": "1.LEVEL_REAL ist der Unterschied zum Rollladenaktor, der ebenfalls ein 1.LEVEL hat, aber keine Ruecklesung - und zur Zentrale HM-RCV-50, die fuenfzig blanke LEVEL-Kanaele fuehrt.",
      "en": "1.LEVEL_REAL is what sets this apart from the roller-shutter actuator, which also has a 1.LEVEL but no position feedback — and from the HM-RCV-50 central unit, which carries fifty bare LEVEL channels."
    }
  },
  "points": [
    {
      "name": "SET",
      "role": "level.dimmer",
      "type": "number",
      "unit": "%",
      "read": "1.LEVEL",
      "write": "1.LEVEL",
      "note": {
        "de": "Die Quelle steht schon auf 0 bis 100, also keine Umrechnung noetig.",
        "en": "The source is already on a 0 to 100 scale, so no conversion is needed."
      }
    },
    {
      "name": "ACTUAL",
      "role": "value.dimmer",
      "type": "number",
      "unit": "%",
      "read": "1.LEVEL_REAL",
      "optional": true,
      "note": {
        "de": "Der tatsaechlich erreichte Wert. Waehrend einer Rampe laeuft er dem Sollwert hinterher.",
        "en": "The value actually reached. During a ramp it lags behind the setpoint."
      }
    },
    {
      "name": "WORKING",
      "role": "indicator.working",
      "type": "boolean",
      "read": "1.WORKING",
      "optional": true,
      "note": {
        "de": "true, solange die Rampe laeuft.",
        "en": "true while the ramp is running."
      }
    },
    {
      "name": "DIRECTION",
      "role": "indicator.direction",
      "type": "number",
      "read": "1.DIRECTION",
      "optional": true,
      "offByDefault": true,
      "note": {
        "de": "0 steht, 1 heller, 2 dunkler, 3 unbekannt.",
        "en": "0 is idle, 1 brighter, 2 darker, 3 unknown."
      }
    },
    {
      "name": "RAMP_TIME",
      "role": "level.timer",
      "type": "number",
      "unit": "s",
      "read": "1.RAMP_TIME",
      "write": "1.RAMP_TIME",
      "optional": true,
      "offByDefault": true,
      "note": {
        "de": "Wie lange der naechste Uebergang dauern soll. Vor dem Setzen von LEVEL schreiben.",
        "en": "How long the next transition should take. Write this before setting LEVEL."
      }
    },
    {
      "name": "ON_TIME",
      "role": "level.timer.off",
      "type": "number",
      "unit": "s",
      "read": "1.ON_TIME",
      "write": "1.ON_TIME",
      "optional": true,
      "offByDefault": true
    },
    {
      "name": "INHIBIT",
      "role": "switch",
      "type": "boolean",
      "read": "1.INHIBIT",
      "write": "1.INHIBIT",
      "optional": true,
      "offByDefault": true,
      "note": {
        "de": "Sperrt den Aktor. Solange true, nimmt er keine Befehle an - auch nicht vom Taster.",
        "en": "Locks the actuator. While true it accepts no commands — not even from the wall switch."
      }
    },
    {
      "name": "UNREACH",
      "role": "indicator.maintenance.unreach",
      "type": "boolean",
      "read": "0.UNREACH",
      "optional": true
    },
    {
      "name": "RSSI",
      "role": "value.rssi",
      "type": "number",
      "unit": "dBm",
      "read": "0.RSSI_DEVICE",
      "optional": true,
      "offByDefault": true,
      "readFallback": {
        "point": "0.RSSI_PEER"
      },
      "note": {
        "de": "RSSI_DEVICE steht zuerst: es ist der Pegel, den die Zentrale vom Geraet empfaengt. RSSI_PEER ist bei Batteriegeraeten oft unbelegt und traegt dann Grenzwerte wie -2147483648.",
        "en": "RSSI_DEVICE comes first: it is the level the central unit receives from the device. RSSI_PEER is often empty on battery devices and then carries sentinel values such as -2147483648."
      }
    }
  ],
