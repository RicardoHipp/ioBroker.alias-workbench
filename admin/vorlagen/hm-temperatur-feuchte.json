{
  "id": "hm-temperatur-feuchte",
  "version": 2,
  "rang": 40,
  "name": {
    "de": "Homematic Temperatur- und Feuchtefühler",
    "en": "Homematic temperature and humidity sensor"
  },
  "geraetetyp": "temperature",
  "funktion": "temperature_sensor",
  "hinweis": {
    "de": "HM-WDS40-TH-I und Verwandte. Reiner Fühler ohne Stellglied — im temperature-Muster ist die Temperatur der Hauptwert und die Feuchte steht daneben.",
    "en": "HM-WDS40-TH-I and relatives. A plain sensor with nothing to actuate; in the temperature pattern temperature is the main value and humidity sits alongside."
  },
  "erkennung": {
    "erforderlich": [
      "1.TEMPERATURE",
      "1.HUMIDITY"
    ],
    "verboten": [
      "1.SET_POINT_TEMPERATURE",
      "1.ACTUAL_TEMPERATURE"
    ],
    "hinweis": "Die Thermostate messen ebenfalls Temperatur und Feuchte, heissen ihre Punkte aber ACTUAL_TEMPERATURE und haben einen Sollwert. Beides ist hier verboten, sonst wuerde diese Vorlage ihnen den Rang ablaufen und das Stellglied unter den Tisch fallen."
  },
  "zustaende": [
    {
      "name": "ACTUAL",
      "rolle": "value.temperature",
      "typ": "number",
      "einheit": "°C",
      "lesen": "1.TEMPERATURE"
    },
    {
      "name": "HUMIDITY",
      "rolle": "value.humidity",
      "typ": "number",
      "einheit": "%",
      "lesen": "1.HUMIDITY"
    },
    {
      "name": "LOWBAT",
      "rolle": "indicator.lowbat",
      "typ": "boolean",
      "lesen": "0.LOWBAT",
      "lesenSonst": {
        "punkt": "0.LOW_BAT"
      },
      "optional": true
    },
    {
      "name": "UNREACH",
      "rolle": "indicator.maintenance.unreach",
      "typ": "boolean",
      "lesen": "0.UNREACH",
      "optional": true
    },
    {
      "name": "RSSI",
      "rolle": "value.rssi",
      "typ": "number",
      "einheit": "dBm",
      "lesen": "0.RSSI_DEVICE",
      "lesenSonst": {
        "punkt": "0.RSSI_PEER"
      },
      "optional": true,
      "vorgabeAus": true,
      "hinweis": "RSSI_DEVICE steht zuerst: es ist der Pegel, den die Zentrale vom Geraet empfaengt. RSSI_PEER ist bei Batteriegeraeten oft unbelegt und traegt dann Grenzwerte wie -2147483648."
    }
  ],
