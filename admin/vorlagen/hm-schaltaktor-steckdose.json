{
  "id": "hm-schaltaktor-steckdose",
  "version": 3,
  "rang": 10,
  "name": {
    "de": "Homematic Schaltaktor als Steckdose",
    "en": "Homematic switch actuator as socket"
  },
  "geraetetyp": "socket",
  "funktion": "socket",
  "hinweis": {
    "de": "Ein Ausgang, der etwas Eingestecktes schaltet. Gleiche Punkte wie die Lampen-Fassung, nur socket statt light. Steht bewusst unter der Lampe: beim Unterputz-Aktor ist Licht der Regelfall.",
    "en": "Single output driving a plugged-in load. Same points as the light variant, socket instead of light."
  },
  "erkennung": {
    "erforderlich": [
      "1.STATE",
      "1.WORKING"
    ],
    "verboten": [
      "2.STATE"
    ],
    "namenshinweis": "steckdose|dose|stecker|plug|socket|pumpe|luefter",
    "hinweis": "1.WORKING steht mit in der Pflicht: es trennt den Schaltaktor vom Fensterkontakt, der ebenfalls einen 1.STATE hat, aber nichts zu schalten. 2.STATE ist verboten, sonst wuerde diese Vorlage auch am Zweifach-Aktor greifen und dessen zweiten Ausgang stillschweigend unterschlagen."
  },
  "zustaende": [
    {
      "name": "SET",
      "rolle": "switch",
      "typ": "boolean",
      "lesen": "1.STATE",
      "schreiben": "1.STATE"
    },
    {
      "name": "ACTUAL",
      "rolle": "sensor.switch",
      "typ": "boolean",
      "lesen": "1.STATE",
      "optional": true,
      "vorgabeAus": true,
      "hinweis": "Liest dieselbe Quelle wie SET - der Aktor meldet keinen getrennten Istwert, 1.STATE ist beides. Deshalb standardmaessig aus: angehakt stuende derselbe Wert zweimal im Alias, und die Pruefung „kein Punkt doppelt\" meldet es zu Recht. Anhaken nur, wenn ein Widget ausdruecklich einen eigenen Rueckmeldepunkt erwartet."
    },
    {
      "name": "WORKING",
      "rolle": "indicator.working",
      "typ": "boolean",
      "lesen": "1.WORKING",
      "optional": true,
      "hinweis": "Steht auf true, solange der Aktor den Befehl noch ausfuehrt."
    },
    {
      "name": "ON_TIME",
      "rolle": "level.timer",
      "typ": "number",
      "einheit": "s",
      "lesen": "1.ON_TIME",
      "schreiben": "1.ON_TIME",
      "optional": true,
      "vorgabeAus": true,
      "hinweis": "Einschaltdauer in Sekunden. Vor dem Einschalten gesetzt, schaltet der Aktor danach von allein wieder aus. Das socket-Muster hat dafuer keinen Platz — angehakt landet der Punkt im info-Geraet."
    },
    {
      "name": "INHIBIT",
      "rolle": "switch",
      "typ": "boolean",
      "lesen": "1.INHIBIT",
      "schreiben": "1.INHIBIT",
      "optional": true,
      "vorgabeAus": true,
      "hinweis": "Sperrt den Aktor. Solange true, nimmt er keine Befehle an — auch nicht vom Taster."
    },
    {
      "name": "LOWBAT",
      "rolle": "indicator.lowbat",
      "typ": "boolean",
      "lesen": "0.LOWBAT",
      "lesenSonst": {
        "punkt": "0.LOW_BAT"
      },
      "optional": true
    },
    {
      "name": "UNREACH",
      "rolle": "indicator.maintenance.unreach",
      "typ": "boolean",
      "lesen": "0.UNREACH",
      "optional": true
    },
    {
      "name": "RSSI",
      "rolle": "value.rssi",
      "typ": "number",
      "einheit": "dBm",
      "lesen": "0.RSSI_DEVICE",
      "optional": true,
      "vorgabeAus": true,
      "lesenSonst": {
        "punkt": "0.RSSI_PEER"
      },
      "hinweis": "RSSI_DEVICE steht zuerst: es ist der Pegel, den die Zentrale vom Geraet empfaengt. RSSI_PEER ist bei Batteriegeraeten oft unbelegt und traegt dann Grenzwerte wie -2147483648."
    }
  ],
