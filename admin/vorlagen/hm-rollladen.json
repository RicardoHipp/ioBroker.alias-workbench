{
  "id": "hm-rollladen",
  "version": 3,
  "rang": 40,
  "name": {
    "de": "Homematic Rollladenaktor",
    "en": "Homematic blind actuator"
  },
  "geraetetyp": "blind",
  "funktion": "shutters",
  "hinweis": {
    "de": "HM-LC-Bl1PBU-FM und Verwandte. LEVEL steht an der Quelle schon auf 0 bis 100 Prozent, wobei 100 offen heißt — genau die Zählrichtung, die das blind-Muster erwartet.",
    "en": "HM-LC-Bl1PBU-FM and relatives. LEVEL is already 0 to 100 percent at the source, 100 meaning open."
  },
  "erkennung": {
    "erforderlich": [
      "1.LEVEL",
      "1.STOP"
    ],
    "hinweis": "1.STOP trennt den Rollladen vom Dimmer: nur ein Fahrantrieb laesst sich mitten in der Bewegung anhalten. Es haelt auch die Zentrale HM-RCV-50 fern, die fuenfzig blanke LEVEL-Kanaele fuehrt."
  },
  "zustaende": [
    {
      "name": "SET",
      "rolle": "level.blind",
      "typ": "number",
      "einheit": "%",
      "lesen": "1.LEVEL",
      "schreiben": "1.LEVEL"
    },
    {
      "name": "ACTUAL",
      "rolle": "value.blind",
      "typ": "number",
      "einheit": "%",
      "lesen": "1.LEVEL",
      "optional": true,
      "hinweis": "Liest dieselbe Quelle wie SET - der Aktor meldet keinen getrennten Istwert, waehrend der Fahrt steht in 1.LEVEL schon das Ziel. Deshalb nicht vorgehakt: angehakt stuende derselbe Wert zweimal im Alias und die Pruefung „kein Punkt doppelt\" meldet es zu Recht. Ob die Fahrt noch laeuft, sagt WORKING. Anhaken nur, wenn ein Widget ausdruecklich einen eigenen Istwert erwartet.",
      "vorgabeAus": true
    },
    {
      "name": "STOP",
      "rolle": "button.stop",
      "typ": "boolean",
      "schreiben": "1.STOP",
      "optional": true,
      "hinweis": "Nur schreiben - ein Tastendruck hat keinen Zustand zum Lesen."
    },
    {
      "name": "DIRECTION",
      "rolle": "indicator.direction",
      "typ": "number",
      "lesen": "1.DIRECTION",
      "optional": true,
      "hinweis": "0 steht, 1 faehrt auf, 2 faehrt zu, 3 unbekannt."
    },
    {
      "name": "WORKING",
      "rolle": "indicator.working",
      "typ": "boolean",
      "lesen": "1.WORKING",
      "optional": true,
      "hinweis": "true, solange der Antrieb laeuft."
    },
    {
      "name": "INHIBIT",
      "rolle": "switch",
      "typ": "boolean",
      "lesen": "1.INHIBIT",
      "schreiben": "1.INHIBIT",
      "optional": true,
      "vorgabeAus": true,
      "hinweis": "Sperrt den Aktor. Solange true, nimmt er keine Befehle an - auch nicht vom Taster."
    },
    {
      "name": "UNREACH",
      "rolle": "indicator.maintenance.unreach",
      "typ": "boolean",
      "lesen": "0.UNREACH",
      "optional": true
    },
    {
      "name": "RSSI",
      "rolle": "value.rssi",
      "typ": "number",
      "einheit": "dBm",
      "lesen": "0.RSSI_DEVICE",
      "optional": true,
      "vorgabeAus": true,
      "lesenSonst": {
        "punkt": "0.RSSI_PEER"
      },
      "hinweis": "RSSI_DEVICE steht zuerst: es ist der Pegel, den die Zentrale vom Geraet empfaengt. RSSI_PEER ist bei Batteriegeraeten oft unbelegt und traegt dann Grenzwerte wie -2147483648."
    }
  ],
